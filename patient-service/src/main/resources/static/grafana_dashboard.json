{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "heatmap", "name": "Heatmap", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0,211,255,1)", "name": "Annotations & Alerts", "type": "dashboard" }] },
  "description": "Production-grade monitoring for distributed Java/Spring Boot services with JVM, system, thread pool, Kafka, cache and DB metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🔵 System Overview",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.9 }] },
          "mappings": [{ "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Service Health",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "up{job=~\"$service\"}", "legendFormat": "{{job}} / {{instance}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 8 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 2,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Requests Per Second — by Service",
      "type": "timeseries",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[$__rate_interval])) by (job)", "legendFormat": "{{job}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 3,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Latency — P50 / P95 / P99",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le)) * 1000", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le)) * 1000", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le)) * 1000", "legendFormat": "P99", "refId": "C" }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "percentunit", "max": 0.1, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "id": 4,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "title": "Error Rate % by Service",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\",status=~\"5..\"}[$__rate_interval])) by (job) / sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[$__rate_interval])) by (job)", "legendFormat": "{{job}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P95" }, "properties": [{ "id": "custom.width", "value": 80 }] },
          { "matcher": { "id": "byName", "options": "P99" }, "properties": [{ "id": "custom.width", "value": 80 }, { "id": "thresholds", "value": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 400 }] } }, { "id": "custom.displayMode", "value": "color-background" }] }
        ]
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 13 },
      "id": 5,
      "options": { "sortBy": [{ "displayName": "P99", "desc": true }], "footer": { "show": false } },
      "title": "Top Slow Endpoints",
      "type": "table",
      "targets": [
        { "expr": "topk(15, histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])) by (le,uri,job)) * 1000)", "legendFormat": "", "refId": "A", "instant": true, "format": "table" },
        { "expr": "topk(15, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])) by (le,uri,job)) * 1000)", "legendFormat": "", "refId": "B", "instant": true, "format": "table" },
        { "expr": "topk(15, histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])) by (le,uri,job)) * 1000)", "legendFormat": "", "refId": "C", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "uri": "Endpoint", "job": "Service", "Value #A": "P50 (ms)", "Value #B": "P95 (ms)", "Value #C": "P99 (ms)" } } }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 101,
      "title": "☕ JVM Metrics",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 12 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "id": 10,
      "title": "JVM Heap Memory — Used / Committed / Max",
      "type": "timeseries",
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\",job=~\"$service\"}", "legendFormat": "{{job}} used", "refId": "A" },
        { "expr": "jvm_memory_committed_bytes{area=\"heap\",job=~\"$service\"}", "legendFormat": "{{job}} committed", "refId": "B" },
        { "expr": "jvm_memory_max_bytes{area=\"heap\",job=~\"$service\"}", "legendFormat": "{{job}} max", "refId": "C" }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "id": 11,
      "title": "GC Pauses — Minor & Major (ms/min)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum{action=\"end of minor GC\",job=~\"$service\"}[$__rate_interval]) * 1000 * 60", "legendFormat": "{{job}} minor GC ms", "refId": "A" },
        { "expr": "rate(jvm_gc_pause_seconds_sum{action=\"end of major GC\",job=~\"$service\"}[$__rate_interval]) * 1000 * 60", "legendFormat": "{{job}} major GC ms", "refId": "B" }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "id": 12,
      "title": "JVM Threads — Live / Daemon / Peak",
      "type": "timeseries",
      "targets": [
        { "expr": "jvm_threads_live_threads{job=~\"$service\"}", "legendFormat": "{{job}} live", "refId": "A" },
        { "expr": "jvm_threads_daemon_threads{job=~\"$service\"}", "legendFormat": "{{job}} daemon", "refId": "B" },
        { "expr": "jvm_threads_peak_threads{job=~\"$service\"}", "legendFormat": "{{job}} peak", "refId": "C" }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 102,
      "title": "🖥  System Metrics (per Host)",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "id": 20,
      "title": "CPU Utilization % per Host",
      "type": "timeseries",
      "targets": [{ "expr": "100 - (avg by (instance)(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[$__rate_interval])) * 100)", "legendFormat": "{{instance}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
      "id": 21,
      "title": "Memory Usage % per Host",
      "type": "timeseries",
      "targets": [{ "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"})) * 100", "legendFormat": "{{instance}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "Bps", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
      "id": 22,
      "title": "Disk & Network I/O per Host",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total{instance=~\"$instance\",device!=\"sr0\"}[$__rate_interval])", "legendFormat": "{{instance}} disk read", "refId": "A" },
        { "expr": "rate(node_disk_written_bytes_total{instance=~\"$instance\",device!=\"sr0\"}[$__rate_interval])", "legendFormat": "{{instance}} disk write", "refId": "B" },
        { "expr": "rate(node_network_receive_bytes_total{instance=~\"$instance\",device!~\"lo\"}[$__rate_interval])", "legendFormat": "{{instance}} net in", "refId": "C" },
        { "expr": "rate(node_network_transmit_bytes_total{instance=~\"$instance\",device!~\"lo\"}[$__rate_interval])", "legendFormat": "{{instance}} net out", "refId": "D" }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 103,
      "title": "🧵 Thread Pool & Performance",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "id": 30,
      "title": "Thread Pool — Active vs Idle vs Queue",
      "type": "timeseries",
      "targets": [
        { "expr": "executor_active_threads{job=~\"$service\",name=~\"$pool\"}", "legendFormat": "{{job}} {{name}} active", "refId": "A" },
        { "expr": "executor_pool_size_threads{job=~\"$service\",name=~\"$pool\"} - executor_active_threads{job=~\"$service\",name=~\"$pool\"}", "legendFormat": "{{job}} {{name}} idle", "refId": "B" },
        { "expr": "executor_queued_tasks{job=~\"$service\",name=~\"$pool\"}", "legendFormat": "{{job}} {{name}} queued", "refId": "C" }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" } },
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 40 },
      "id": 31,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto" },
      "title": "Task Rejections (5m)",
      "type": "stat",
      "targets": [{ "expr": "increase(executor_rejected_tasks_total{job=~\"$service\",name=~\"$pool\"}[5m])", "legendFormat": "{{job}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "mappings": [{ "options": { "0": { "color": "green", "index": 0, "text": "None ✓" } }, "type": "value" }] } },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 40 },
      "id": 32,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "title": "Deadlocked Threads",
      "type": "stat",
      "targets": [{ "expr": "jvm_threads_deadlocked{job=~\"$service\"}", "legendFormat": "{{job}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "id": 33,
      "options": { "displayMode": "lcd", "orientation": "vertical" },
      "title": "Thread Pool Utilization % by Pool",
      "type": "bargauge",
      "targets": [{ "expr": "executor_active_threads{job=~\"$service\"} / executor_pool_size_threads{job=~\"$service\"}", "legendFormat": "{{job}} / {{name}}", "refId": "A", "instant": true }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 104,
      "title": "📦 External Dependencies — DB / Cache / Kafka / APIs",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 49 },
      "id": 40,
      "title": "DB Query Latency — Avg & P95",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(db_query_duration_seconds_sum{job=~\"$service\"}[$__rate_interval]) / rate(db_query_duration_seconds_count{job=~\"$service\"}[$__rate_interval]) * 1000", "legendFormat": "{{job}} avg", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le,job)) * 1000", "legendFormat": "{{job}} P95", "refId": "B" }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 15 }, "min": 0, "max": 1 } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 49 },
      "id": 41,
      "title": "Cache Hit Rate % (Redis / Caffeine)",
      "type": "timeseries",
      "targets": [{ "expr": "rate(cache_gets_total{result=\"hit\",job=~\"$service\"}[$__rate_interval]) / rate(cache_gets_total{job=~\"$service\"}[$__rate_interval])", "legendFormat": "{{job}} {{name}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 5000 }] } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 49 },
      "id": 42,
      "title": "Kafka Consumer Lag by Topic",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (topic) (kafka_consumer_fetch_manager_records_lag{job=~\"$service\"})", "legendFormat": "{{topic}}", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 },
      "id": 105,
      "title": "🔥 Latency Heatmap",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 58 },
      "id": 50,
      "options": {
        "calculate": false,
        "cellGap": 2,
        "color": { "exponent": 0.5, "fill": "dark-orange", "mode": "scheme", "reverse": false, "scale": "exponential", "scheme": "Oranges", "steps": 128 },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "show": true, "yHistogram": false },
        "yAxis": { "axisPlacement": "left", "decimals": 0, "reverse": false, "unit": "ms" }
      },
      "title": "Request Latency Heatmap",
      "type": "heatmap",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[$__rate_interval])) by (le)", "format": "heatmap", "legendFormat": "{{le}}", "refId": "A" }]
    }

  ],

  "schemaVersion": 38,
  "tags": ["java", "spring-boot", "jvm", "prometheus", "distributed", "production"],
  "templating": {
    "list": [
      {
        "current": {}, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(up, job)", "hide": 0, "includeAll": true, "multi": true,
        "name": "service", "options": [], "query": { "query": "label_values(up, job)", "refId": "StandardVariableQuery" },
        "refresh": 2, "regex": "", "sort": 0, "type": "query", "label": "Service"
      },
      {
        "current": {}, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(node_cpu_seconds_total, instance)", "hide": 0, "includeAll": true, "multi": true,
        "name": "instance", "options": [], "query": { "query": "label_values(node_cpu_seconds_total, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2, "type": "query", "label": "Host / Instance"
      },
      {
        "current": {}, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(executor_active_threads, name)", "hide": 0, "includeAll": true, "multi": true,
        "name": "pool", "options": [], "query": { "query": "label_values(executor_active_threads, name)", "refId": "StandardVariableQuery" },
        "refresh": 2, "type": "query", "label": "Thread Pool"
      },
      {
        "current": { "selected": true, "text": "5m", "value": "5m" },
        "hide": 0, "includeAll": false, "multi": false,
        "name": "rate_interval", "options": [
          { "selected": false, "text": "1m", "value": "1m" },
          { "selected": true, "text": "5m", "value": "5m" },
          { "selected": false, "text": "15m", "value": "15m" }
        ],
        "query": "1m,5m,15m", "type": "custom", "label": "Rate Interval"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"] },
  "timezone": "browser",
  "title": "Java Distributed Services — Production Monitor",
  "uid": "java-prod-monitor-v1",
  "version": 1
}
